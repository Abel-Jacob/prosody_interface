# =================================================================
# Prosody Interface — Server Environment Configuration
# Copy this file to .env and adjust values for your work server.
# =================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000

# CORS Origins (Comma-separated list, or * to allow all including Vercel)
# Example: https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# Device Configuration: 'cuda' for NVIDIA GPU, 'cpu' for CPU-only server
# Leave empty to auto-detect CUDA if available
# ASR_DEVICE=cuda
# WHISTRESS_DEVICE=cuda

# Whisper Model Size:
# On GPU: 'medium.en' (highest accuracy) or 'base.en' (fast)
# On CPU: 'base.en' (recommended for CPU speed)
# ASR_MODEL_SIZE_FINAL=medium.en

# Upload Limits (in Megabytes)
MAX_SINGLE_AUDIO_MB=100
MAX_ZIP_UPLOAD_MB=250
MAX_BATCH_FILE_COUNT=50
MAX_DATASET_MB=500
